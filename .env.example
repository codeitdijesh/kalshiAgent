# Copy this file to .env and fill in your keys. See HANDOVER.md § API Keys.

# Apify — powers the TikTok Oracle (required for the Alpha Override)
APIFY_API_TOKEN=

# Kalshi Trade API v2 — optional; public quotes work without keys
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# TMDB — optional oracle (free key)
TMDB_API_KEY=

# YouTube Data API v3 — optional oracle (free quota)
YOUTUBE_API_KEY=

# Optional overrides
# KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
# WIKI_API_USER_AGENT=KalshiMasterAgent/1.0 (research project)
